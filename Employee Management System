--20	Write a query to retrieve two minimum and maximum salaries from the EmployeePosition table
	-- Two Minimum Salaries
	SELECT TOP (2) Salary
	FROM [dbo].['Employee position$']
	WHERE DateOfJoining IS NOT NULL
	ORDER BY Salary ASC

	-- Two Maximum Salaries
	SELECT TOP 2 Salary
	FROM [dbo].['Employee position$']
	WHERE DateOfJoining IS NOT NULL
	ORDER BY Salary DESC;

--BEST APPROACH OF ANSWERING THE QUESTION
WITH CTE AS(
SELECT *
	    , RANK() OVER(ORDER BY Salary DESC) AS ascending
		, RANK() OVER(ORDER BY Salary ASC) AS decending
FROM [dbo].['Employee position$']
WHERE DateOfJoining IS NOT NULL
)

SELECT *
FROM CTE
WHERE ascending <=2 or decending <=2
